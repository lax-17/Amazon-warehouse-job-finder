# Amazon Jobs Monitor v2 - Minimal Configuration
# Token is automatically loaded from .amazon_jobs_token file

# Database
DATABASE_PATH=data/jobs.db

# Monitoring Settings
POLL_INTERVAL_SECONDS=30
MAX_HISTORICAL_DAYS=30

# Search Defaults
DEFAULT_LOCATION=Leeds, UK
DEFAULT_RADIUS_MILES=50
DEFAULT_JOB_TYPE=part-time

# Logging
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true

# Web Dashboard
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_DEBUG=false

# Notifications (optional - leave empty to disable)
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_TO=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
